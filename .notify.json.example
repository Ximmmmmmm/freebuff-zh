    { "format": "bark",       "url": "https://api.day.app/替换为你的Key" },
    { "format": "serverchan", "url": "https://sctapi.ftqq.com/替换为你的SendKey.send" },
    { "format": "generic",    "url": "https://你的自建服务/hook" }
  ],
