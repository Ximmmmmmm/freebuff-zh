+    <script>
+      ;(function () {
+        var sent = {}
+        function report(name, message, stack) {
+          if (!message || sent[name + message]) return
+          sent[name + message] = 1
+          try {
+            fetch('/api/diagnostics/renderer-error', {
+              method: 'POST',
+              headers: { 'content-type': 'application/json' },
+              body: JSON.stringify({ name: name, message: message, stack: stack, boundary: 'bootstrap' }),
+              // survives the window being closed on a dead-looking app
+              keepalive: true,
+            })['catch'](function () {})
+          } catch (e) {}
+        }
+        // Capture phase: a failed script or stylesheet fires on the element and does not bubble.
+        // Images are content, not renderer failures, and would only add noise here.
+        window.addEventListener(
+          'error',
+          function (event) {
+            var el = event.target
+            if (el && el !== window && el.tagName) {
+              if (el.tagName === 'SCRIPT' || el.tagName === 'LINK') {
+                report(
+                  'ResourceError',
+                  'failed to load ' + el.tagName.toLowerCase() + ': ' + (el.src || el.href || ''),
+                )
+              }
+              return
+            }
+            report((event.error && event.error.name) || 'Error', event.message, event.error && event.error.stack)
+          },
